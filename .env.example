# py_chat-chat-python — environment template.
# PLACEHOLDERS ONLY. Never commit real values. Variable names and semantics match the
# Node service (src/config/envs.config.js); blank = Node default applies.

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=7091
LOG_LEVEL=info
HTTP_REQUEST_TIMEOUT_MS=
HTTP_KEEP_ALIVE_TIMEOUT_MS=
GLOBAL_RATE_LIMIT_MAX=
HTTP_COMPRESSION_ENABLED=
ALLOWED_ORIGINS=

# ── Database (MySQL) ─────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=py_chat
DB_USER=py_chat
DB_PASS=change-me
DB_DIALECT=mysql
POOL_MAX=
POOL_MIN=
POOL_ACQUIRE=
POOL_IDLE=

# ── Redis cache ──────────────────────────────────────────────────
INVALIDATION_BUS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_LONG=
CACHE_TTL_LIST=
CACHE_TTL_DUPLICATE=
IS_REDIS_ENABLED=true
REDIS_TLS_ENABLED=
REDIS_TLS=
REDIS_CONNECT_TIMEOUT=
REDIS_COMMAND_TIMEOUT=
REDIS_RETRY_DELAY=
REDIS_RETRY_MAX_DELAY=
REDIS_SOCKET_ADAPTER_ENABLED=false
REDIS_SOCKET_ADAPTER_SHARDED=false
REDIS_SOCKET_ADAPTER_HOST=
REDIS_SOCKET_ADAPTER_PORT=
REDIS_SOCKET_ADAPTER_TLS=
REDIS_SOCKET_ADAPTER_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────
API_KEY=change-me
API_KEYS=
ACCESS_TOKEN_SECRET=change-me-to-the-shared-jwt-secret
ACCESS_TOKEN_EXPIRED=
ACCESS_TOKEN_ISSUER=
ACCESS_TOKEN_AUDIENCE=
SOCKET_HANDSHAKE_AUTH_ENFORCE=
SOCKET_RATE_LIMIT_ENABLED=
SOCKET_JWT_BLOCKLIST_PREFIX=
SOCKET_AUTH_CACHE_TTL_MS=
SOCKET_MAX_HTTP_BUFFER_SIZE=

# ── AWS (DynamoDB / S3) ──────────────────────────────────────────
AWS_S3_BASE=
AWS_S3_REGION=your-aws-region
AWS_S3_BUCKET=your-bucket
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_SECURE=
AWS_DYNOMODB_ACCESS_KEY=your-access-key-id
AWS_DYNOMODB_SECRET_KEY=your-secret-access-key
AWS_DYNAMODB_ENDPOINT_URL=
AWS_S3_ENDPOINT_URL=
AWS_REGION=your-aws-region

# ── Providers ────────────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_WEBHOOK_SECRET=
OUTBOUND_HTTP_TIMEOUT_MS=
OUTBOUND_MEDIA_TIMEOUT_MS=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
INFOBIP_AUTHORIZATION=
FCM_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FCM_SERVICE_ACCOUNT_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CHAT_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_MEDIA_UPLOAD_LINK=
MESSAGEBIRD_API_KEY=
GOOGLE_PROJECT_NUMBER=
GOOGLE_POOL_ID=
GOOGLE_PROVIDER_ID=
GOOGLE_SERVICE_ACCOUNT=

# ── Translation ──────────────────────────────────────────────────
TRANSLATE_API_KEY=
TRANSLATE_API_URL=
TRANSLATE_API_TIMEOUT_MS=
TRANSLATE_TARGETS=
TRANSLATE_RETRIES=
TRANSLATE_BACKOFF_BASE_MS=
TRANSLATE_BACKOFF_MAX_MS=
TRANSLATE_BREAKER_THRESHOLD=
TRANSLATE_BREAKER_COOLDOWN_MS=
TRANSLATE_CACHE_TTL_SECONDS=
TRANSLATE_QUEUE_CONCURRENCY=
TRANSLATE_QUEUE_MAX_DEPTH=
TRANSLATE_JOB_RETRIES=
TRANSLATE_JOB_BACKOFF_MS=
TRANSLATE_JOB_BACKOFF_MAX_MS=

# ── Webhook queue ────────────────────────────────────────────────
WEBHOOK_QUEUE_CONCURRENCY=
WEBHOOK_QUEUE_MAX_DEPTH=
WEBHOOK_JOB_RETRIES=
WEBHOOK_JOB_BACKOFF_MS=
WEBHOOK_JOB_BACKOFF_MAX_MS=
WEBHOOK_DEDUPE_TTL_MS=
WEBHOOK_RATE_LIMIT_MAX=
WEBHOOK_FANOUT_CONCURRENCY=

# ── Localisation OTA ─────────────────────────────────────────────
LCC_OTA_ENABLED=false
LANGUAGE_PULL_FROM_SERVER=
LCC_OTA_BASE_URL=
LCC_OTA_POLL_SECONDS=
LCC_OTA_TIMEOUT_MS=
LCC_OTA_CACHE_DIR=
LCC_OTA_LOCALES_DIR=

# ── Chat behaviour ────────────────────────────────────────────────────────
CHAT_CONVERSATION_LIMIT=
CHAT_MESSAGE_LIMIT=
CHAT_GROUP_PARTICIPANTS_LIMIT=
USER_ROLE_EMPLOYER=
USER_ROLE_WORKER=
EXCLUDE_REMOVED_PARTICIPANTS=
SITE_URL=
DEFAULT_PROFILE_IMAGE=
CHAT_LIST_DYNAMO_CONCURRENCY=
DELIVERED_SYNC_PAGE_SIZE=
DELIVERED_SYNC_MAX_MESSAGES=
READ_SYNC_PAGE_SIZE=
READ_SYNC_MAX_MESSAGES=
HISTORY_MAX_GROUPS=
RECEIVER_LOOKUP_PAGE_SIZE=
RECEIVER_LOOKUP_MAX_PAGES=

# ── Python-only ───────────────────────────────────────────────────────────
ENABLE_API_DOCS=false
